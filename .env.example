# =======================================================================
# Nexus Environment Configuration
# =======================================================================
# Only the essential database credentials and API keys are required below.
# All operational limits (ingestion caps, rate limits, session lifecycles,
# agent loops, and tool execution limits) use sensible defaults in backend/config.py.
# =======================================================================

# --- Database Connection & Roles ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=nexus_db
PGUSER=nexus_writer
NEXUS_WRITER_PASSWORD=your_writer_password
NEXUS_READER_PASSWORD=your_reader_password

# --- LLM Provider & Keys ---
MODEL_PROVIDER=openrouter
# MODEL_NAME= (optional override)
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# =======================================================================
# Optional Overrides (Uncomment only to tweak backend/config.py defaults)
# =======================================================================
# COOKIE_SECURE=true                          # Set true in production behind HTTPS
# CORS_ORIGINS=http://localhost:3000          # Comma-separated frontend origins
# UPLOAD_MAX_BYTES=52428800                   # Max upload file size in bytes (default: 50MB)
# UPLOAD_MAX_ROWS=600000                      # Max spreadsheet row count (default: 600,000)
# NEXUS_MAX_TOOL_STEPS=8                      # Max tool steps for Nexus Copilot (default: 8)
# NEXUS_TOOL_SQL_ROW_LIMIT=200                # Max SQL rows returned to Nexus Copilot (default: 200)
# ARCHITECT_MAX_STEPS=6                       # Max profiling steps for Nexus Architect (default: 6)
